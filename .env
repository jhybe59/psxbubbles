NODE_ENV=development
LOG_LEVEL=debug

# TimescaleDB
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=cryptobubbles
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# PSX Terminal live ticks
PSX_API_BASE_URL=https://psxterminal.com/api
PSX_API_STRATEGY=ticks
PSX_API_INTERVAL=1m
PSX_API_LIMIT=1
PSX_API_MARKET=REG
PSX_API_MAX_REQUESTS_PER_MINUTE=30
PSX_API_TIMEOUT_MS=10000

# Worker scheduling (24/7 for dev)
WORKER_POLL_CRON=* * * * *
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=30
WORKER_SYMBOLS_PER_MINUTE=10
WORKER_MARKET_OPEN_TIME=00:00
WORKER_MARKET_CLOSE_TIME=23:59
WORKER_SYMBOL_FETCH_DELAY_MINUTES=0

# API service
API_PORT=8080
API_RATE_LIMIT_POINTS=100
API_RATE_LIMIT_DURATION=60
API_KEY_PRIMARY=dev-api-key
API_KEY_SECONDARY=

# Frontend flags (dotenv-safe expectations)
ENABLE_LIVE_API=true
AUTO_REFRESH_MS=60000
LIVE_API_KEY=
VITE_ENABLE_LIVE_API=true
VITE_LIVE_API_BASE_URL=http://localhost:8080/api
VITE_LIVE_API_KEY=dev-api-key
VITE_ENABLE_REPO_SNAPSHOTS=false
VITE_AUTO_REFRESH_MS=60000

# Metrics
METRICS_PORT=9100