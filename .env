NODE_ENV=development

# Timescale
TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432
TIMESCALE_DB=cryptobubbles
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_SSL=false

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# PSX Terminal upstream
PSX_API_BASE_URL=https://psxterminal.com/api
PSX_API_TOKEN=
PSX_API_TIMEOUT_MS=10000
PSX_API_BATCH_SIZE=80
PSX_API_STRATEGY=klines
PSX_API_INTERVAL=1m
PSX_API_LIMIT=120
PSX_API_MARKET=REG
PSX_API_MAX_REQUESTS_PER_MINUTE=60

# Worker scheduling
WORKER_POLL_CRON=* * * * *
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=30
WORKER_SYMBOLS_PER_MINUTE=100
WORKER_MARKET_OPEN_TIME=09:30
WORKER_MARKET_CLOSE_TIME=15:30
WORKER_SYMBOL_FETCH_DELAY_MINUTES=2

# API service
API_PORT=8080
API_RATE_LIMIT_POINTS=100
API_RATE_LIMIT_DURATION=60
API_KEY_PRIMARY=dev-api-key
API_KEY_SECONDARY=

# Frontend flags (used when you run npm run dev)
ENABLE_LIVE_API=true
AUTO_REFRESH_MS=60000
LIVE_API_KEY=
LOG_LEVEL=info
VITE_ENABLE_LIVE_API=true
VITE_LIVE_API_BASE_URL=http://localhost:8080/api
VITE_LIVE_API_KEY=dev-api-key
VITE_ENABLE_REPO_SNAPSHOTS=false
VITE_AUTO_REFRESH_MS=60000
METRICS_PORT=9100

