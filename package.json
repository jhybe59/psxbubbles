{
  "name": "my-cryptobubbles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "postinstall": "node -e \"try{require('fs').chmodSync('./node_modules/.bin/vite',0o755)}catch(e){}\"",
    "lint": "eslint .",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host --port 3000",
    "backup": "node ./scripts/backup.js",
    "restore": "node ./scripts/restore.js",
    "start-admin": "node ./server/admin.cjs",
    "start:api": "node ./server/api/index.mjs",
    "start:api:auto-migrate": "node ./scripts/start-api-with-migrations.mjs",
    "worker:ingest": "node ./workers/ingestion/index.mjs",
    "db:migrate": "node ./scripts/apply-migrations.js",
    "db:seed": "node ./scripts/seed-dev.js",
    "dev:stack": "docker compose -f docker-compose.dev.yml --env-file config/dev.env up --build -d",
    "dev:stack:down": "docker compose -f docker-compose.dev.yml down -v",
    "bootstrap:dev": "node ./scripts/bootstrap-dev.mjs",
    "dev:check": "node ./scripts/dev-check.mjs",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs",
    "migrate-logos": "node ./scripts/migrate_logos.js",
    "sync:symbols": "node ./scripts/sync-symbols.js"
  },
  "dependencies": {
    "@questdb/nodejs-client": "^4.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.5.9",
    "archiver": "^5.3.1",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "bullmq": "^5.43.0",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^16.4.5",
    "dotenv-safe": "^9.1.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "idb": "^7.1.1",
    "ioredis": "^5.4.2",
    "lightweight-charts": "^5.0.9",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.1",
    "rate-limiter-flexible": "^3.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "technicalindicators": "^3.1.0",
    "vite": "^5.0.0",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "msw": "^2.7.3",
    "playwright": "^1.42.0",
    "supertest": "^7.1.0"
  }
}
