# ML Service Configuration
ML_ENVIRONMENT=development
ML_LOG_LEVEL=INFO

# API
ML_API_HOST=0.0.0.0
ML_API_PORT=8000

# QuestDB (PostgreSQL wire protocol)
ML_QUESTDB_HOST=localhost
ML_QUESTDB_PORT=8812
ML_QUESTDB_USER=admin
ML_QUESTDB_PASSWORD=quest
ML_QUESTDB_DATABASE=qdb

# Redis
ML_REDIS_HOST=localhost
ML_REDIS_PORT=6379
ML_REDIS_DB=0

# Feature Engineering
ML_BAR_TYPE=time
ML_BAR_INTERVAL_SECONDS=60
ML_FEATURE_WINDOW=20

# Model
ML_MODEL_PATH=./models
ML_MODEL_NAME=xgb_baseline_v1
ML_PREDICTION_THRESHOLD=0.6

# Move Detection
ML_MOVE_THRESHOLD_PCT=1.0
ML_MOVE_HORIZON_BARS=10
ML_ATR_MULTIPLIER=2.0
