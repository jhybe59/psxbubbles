NODE_ENV=development

# PostgreSQL (for static data: instruments, indices)
POSTGRES_HOST=questdb
POSTGRES_PORT=8812
POSTGRES_DB=qdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=quest
POSTGRES_SSL=false

# QuestDB (for real-time time-series data)
QUESTDB_HOST=questdb
QUESTDB_HTTP_PORT=9000
QUESTDB_ILP_PORT=9009

# Redis / BullMQ
REDIS_URL=redis://redis:6379

# PSX Terminal upstream
PSX_API_BASE_URL=https://psxterminal.com/api
PSX_API_TOKEN=
PSX_API_TIMEOUT_MS=10000
PSX_API_BATCH_SIZE=80
PSX_API_STRATEGY=klines
PSX_API_INTERVAL=1m
PSX_API_LIMIT=120
PSX_API_MARKET=REG
PSX_API_MAX_REQUESTS_PER_MINUTE=100


# Worker scheduling
WORKER_POLL_CRON=* * * * *
WORKER_MAX_RETRIES=2
WORKER_RETRY_BACKOFF_SECONDS=5
WORKER_SYMBOLS_PER_MINUTE=100
WORKER_MARKET_OPEN_TIME=04:30
WORKER_MARKET_CLOSE_TIME=10:30
WORKER_SYMBOL_FETCH_DELAY_MINUTES=2

# API service
API_PORT=8080
API_RATE_LIMIT_POINTS=100
API_RATE_LIMIT_DURATION=60
API_KEY_PRIMARY=dev-api-key
API_KEY_SECONDARY=

# Frontend flags (used when you run npm run dev)
ENABLE_LIVE_API=true
AUTO_REFRESH_MS=60000
LOG_LEVEL=info
VITE_ENABLE_LIVE_API=true
VITE_LIVE_API_BASE_URL=http://localhost:8080/api
VITE_LIVE_API_KEY=dev-api-key
VITE_ENABLE_REPO_SNAPSHOTS=false
VITE_AUTO_REFRESH_MS=60000
METRICS_PORT=9100

