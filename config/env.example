## Environment configuration for live PSX bubbles

# Core runtime
NODE_ENV=development

# TimescaleDB connection
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=cryptobubbles
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# External PSX API (PSX Terminal)
PSX_API_BASE_URL=https://psxterminal.com/api
PSX_API_TOKEN=replace-with-api-token
PSX_API_TIMEOUT_MS=10000
PSX_API_BATCH_SIZE=80
PSX_API_STRATEGY=minute-bars
PSX_API_INTERVAL=1m
PSX_API_LIMIT=120
PSX_API_MARKET=REG
PSX_API_MAX_REQUESTS_PER_MINUTE=100

# Worker settings
WORKER_POLL_CRON=* * * * *
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=30

# API service
API_PORT=8080
API_RATE_LIMIT_POINTS=100
API_RATE_LIMIT_DURATION=60
# Optional secondary key for rotation
API_KEY_PRIMARY=dev-api-key
API_KEY_SECONDARY=

# Frontend feature flags
ENABLE_LIVE_API=true
AUTO_REFRESH_MS=60000
LIVE_API_KEY=
VITE_ENABLE_LIVE_API=true
VITE_LIVE_API_BASE_URL=http://localhost:8080/api
VITE_LIVE_API_KEY=dev-api-key
VITE_ENABLE_REPO_SNAPSHOTS=false
VITE_AUTO_REFRESH_MS=60000

# Prometheus metrics
METRICS_PORT=9100

# Logging
LOG_LEVEL=info

